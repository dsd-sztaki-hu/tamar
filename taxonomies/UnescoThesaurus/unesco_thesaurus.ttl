:concept3614 a skos:Concept ;
    dcterms:modified "2019-12-15T14:33:47+00:00"^^xsd:dateTime ;
    skos:altLabel "احتياجات الانسان"@ar,
        "احتياجات بشرية"@ar,
        "حاجات اساسية"@ar,
        "حاجات انسانية"@ar,
        "Human needs"@en,
        "Necesidades fundamentales"@es,
        "Necesidades humanas"@es,
        "Besoins fondamentaux"@fr,
        "Besoins humains"@fr,
        "Потребности человека"@ru ;
    skos:broader :concept7876 ;
    skos:hiddenLabel "Necesidades basicas"@es ;
    skos:prefLabel "احتياجات اساسية"@ar,
        "Basic needs"@en,
        "Necesidades básicas"@es,
        "Besoins essentiels"@fr,
        "Базовые потребности"@ru ;
    skos:related :concept17074,
        :concept1812,
        :concept2041,
        :concept3617,
        :concept3618,
        :concept3619,
        :concept3620,
        :concept3621,
        :concept3622,
        :concept557 ;
    skos:scopeNote "الحد أدنى من مستلزمات العيش الكريم:  توفير قدر كاف من الغذاء، والمأوى، والملبس، والخدمات المجتمعية. ويشمل أيضا الاحتياجات المتعلقة بحقوق الإنسان، ومشاركة الجمهور في اتخاذ القرارات، والعمالة المنتجة."@ar,
        "The minimum requirements for a decent standard of life: adequate food, shelter, clothing, community services. They also include needs relating to human rights, public participation in decision-making, productive employment."@en,
        "Condiciones mínimas indispensables para tener un nivel de vida decente: comida adecuada, techo, ropa y servicios comunitarios. Incluyen también necesidades relacionadas con los derechos humanos, la participación en las decisiones colectivas y un trabajo remunerado."@es,
        "Conditions minimales indispensables à un niveau de vie décent: nourriture appropriée, toit, vêtements, services communautaires. Ces conditions incluent aussi les besoins liés aux droits de l'homme, la participation à la prise de décision collective, un emploi rémunérateur."@fr,
        "Минимальные потребности, удовлетворение которых создает достойный уровень жизни: достаточное обеспечение продуктами питания, жильем, одеждой, коммунальными услугами. Включают также потребности, относящиеся к правам человека, участию общественности в принятии решений, производительному труду."@ru .

:concept3619 a skos:Concept ;
